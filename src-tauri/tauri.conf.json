{
  "productName": "presentation-timer",
  "version": "1.2.0",
  "identifier": "com.saintpbh.timer",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "⏱  프리미엄 프레젠테이션 타이머",
        "width": 390,
        "height": 620,
        "resizable": true,
        "decorations": true,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Timer Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "fullscreen": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
