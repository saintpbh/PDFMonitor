{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the application",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "allow-get-monitors",
    "allow-move-overlay-to-monitor",
    "allow-set-overlay-clickthrough",
    "allow-set-overlay-visible",
    "allow-share-timer-state"
  ]
}
